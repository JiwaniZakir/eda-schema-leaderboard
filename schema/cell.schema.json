{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jiwanizakir.github.io/eda-schema-leaderboard/schema/cell.schema.json",
  "title": "Leaderboard cell record",
  "description": "One (task, metric, pdk, stage) cell. Values are stored in registry units: percent-format metrics are fractions in [0,1] and are multiplied by 100 only at display. NOTE: a MAPE that was already scaled by 100 at ingest is NOT catchable here, because MAPE legitimately exceeds 100% (Table 8 publishes 122.69%, and sentinels reach 10000%). Only Phase 5's plausibility layer can catch that.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task",
    "metric",
    "pdk",
    "stage",
    "source"
  ],
  "properties": {
    "task": {
      "enum": [
        "total_area_prediction",
        "total_power_prediction",
        "total_wirelength_prediction",
        "interconnect_length_prediction",
        "worst_arrival_time_prediction",
        "worst_slack_prediction",
        "total_negative_slack_prediction",
        "timing_path_arrival_time_prediction",
        "timing_path_slack_prediction",
        "net_arc_delay_prediction",
        "cell_arc_delay_prediction",
        "cell_arc_slew_prediction"
      ]
    },
    "metric": {
      "enum": [
        "mae",
        "mape",
        "r2",
        "mpe",
        "mne",
        "tpr",
        "tnr",
        "mae_p95",
        "mape_p95",
        "mae_top5",
        "mape_top5"
      ]
    },
    "pdk": {
      "enum": [
        "ng45",
        "sky130",
        "ihp130",
        "asap7"
      ]
    },
    "stage": {
      "enum": [
        "floorplan",
        "global_place",
        "detailed_place",
        "cts",
        "global_route"
      ]
    },
    "value_macro": {
      "type": [
        "number",
        "null"
      ]
    },
    "value_pooled": {
      "type": [
        "number",
        "null"
      ]
    },
    "ranked_on": {
      "enum": [
        "macro",
        "pooled"
      ]
    },
    "sentinel": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "> 10000 %",
        "< -1",
        null
      ]
    },
    "source": {
      "enum": [
        "paper",
        "synthetic",
        "submission"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "task": {
            "const": "total_area_prediction"
          }
        },
        "required": [
          "task"
        ]
      },
      "then": {
        "properties": {
          "metric": {
            "enum": [
              "mae",
              "mape",
              "r2"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "total_power_prediction"
          }
        },
        "required": [
          "task"
        ]
      },
      "then": {
        "properties": {
          "metric": {
            "enum": [
              "mae",
              "mape",
              "r2"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "total_wirelength_prediction"
          }
        },
        "required": [
          "task"
        ]
      },
      "then": {
        "properties": {
          "metric": {
            "enum": [
              "mae",
              "mape",
              "r2"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "interconnect_length_prediction"
          }
        },
        "required": [
          "task"
        ]
      },
      "then": {
        "properties": {
          "metric": {
            "enum": [
              "mae",
              "mape",
              "r2",
              "mae_p95",
              "mape_p95",
              "mae_top5",
              "mape_top5"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "worst_arrival_time_prediction"
          }
        },
        "required": [
          "task"
        ]
      },
      "then": {
        "properties": {
          "metric": {
            "enum": [
              "mae",
              "mape"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "worst_slack_prediction"
          }
        },
        "required": [
          "task"
        ]
      },
      "then": {
        "properties": {
          "metric": {
            "enum": [
              "mae",
              "mpe",
              "mne",
              "tpr",
              "tnr"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "total_negative_slack_prediction"
          }
        },
        "required": [
          "task"
        ]
      },
      "then": {
        "properties": {
          "metric": {
            "enum": [
              "mae",
              "mpe",
              "mne"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "timing_path_arrival_time_prediction"
          }
        },
        "required": [
          "task"
        ]
      },
      "then": {
        "properties": {
          "metric": {
            "enum": [
              "mae",
              "mape",
              "mae_p95",
              "mape_p95",
              "mae_top5",
              "mape_top5"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "timing_path_slack_prediction"
          }
        },
        "required": [
          "task"
        ]
      },
      "then": {
        "properties": {
          "metric": {
            "enum": [
              "mae",
              "mpe",
              "mne",
              "tpr",
              "tnr"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "net_arc_delay_prediction"
          }
        },
        "required": [
          "task"
        ]
      },
      "then": {
        "properties": {
          "metric": {
            "enum": [
              "mae",
              "mape",
              "r2"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "cell_arc_delay_prediction"
          }
        },
        "required": [
          "task"
        ]
      },
      "then": {
        "properties": {
          "metric": {
            "enum": [
              "mae",
              "mape",
              "r2"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "cell_arc_slew_prediction"
          }
        },
        "required": [
          "task"
        ]
      },
      "then": {
        "properties": {
          "metric": {
            "enum": [
              "mae",
              "mape",
              "r2"
            ]
          }
        }
      }
    },
    {
      "not": {
        "properties": {
          "task": {
            "const": "total_wirelength_prediction"
          },
          "stage": {
            "const": "floorplan"
          }
        },
        "required": [
          "task",
          "stage"
        ]
      }
    },
    {
      "not": {
        "properties": {
          "task": {
            "const": "interconnect_length_prediction"
          },
          "stage": {
            "const": "floorplan"
          }
        },
        "required": [
          "task",
          "stage"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "ranked_on": {
            "const": "macro"
          }
        },
        "required": [
          "ranked_on"
        ]
      },
      "then": {
        "properties": {
          "value_macro": {
            "type": "number"
          }
        },
        "required": [
          "value_macro"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "ranked_on": {
            "const": "pooled"
          }
        },
        "required": [
          "ranked_on"
        ]
      },
      "then": {
        "properties": {
          "value_pooled": {
            "type": "number"
          }
        },
        "required": [
          "value_pooled"
        ]
      }
    }
  ]
}
