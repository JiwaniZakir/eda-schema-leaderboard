{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jiwanizakir.github.io/eda-schema-leaderboard/schema/submission.schema.json",
  "title": "Leaderboard submission",
  "description": "A community submission. Written to what the Phase 5 guard layers need, so they extend this rather than redesign it. `features` is checked against Table 1 stage availability by guard layer 1; `split` by layer 2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "submission_id",
    "model_name",
    "authors",
    "submitted_at",
    "division",
    "results",
    "source"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "submission_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "model_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "affiliation": {
            "type": "string"
          },
          "orcid": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$"
          }
        }
      }
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "division": {
      "enum": [
        "open",
        "closed"
      ]
    },
    "architecture": {
      "type": "string"
    },
    "code_url": {
      "type": "string",
      "format": "uri"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "train",
        "test"
      ],
      "properties": {
        "train": {
          "type": "array",
          "items": {
            "enum": [
              "ac97_ctrl",
              "aes_core",
              "des3_area",
              "ethernet",
              "i2c",
              "jpeg",
              "mem_ctrl",
              "pci",
              "sasc",
              "simple_spi",
              "spi",
              "ss_pcm",
              "systemcaes",
              "systemcdes",
              "tv80",
              "usb_funct",
              "usb_phy",
              "wb_dma"
            ]
          }
        },
        "test": {
          "type": "array",
          "items": {
            "enum": [
              "ac97_ctrl",
              "aes_core",
              "des3_area",
              "ethernet",
              "i2c",
              "jpeg",
              "mem_ctrl",
              "pci",
              "sasc",
              "simple_spi",
              "spi",
              "ss_pcm",
              "systemcaes",
              "systemcdes",
              "tv80",
              "usb_funct",
              "usb_phy",
              "wb_dma"
            ]
          }
        }
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://jiwanizakir.github.io/eda-schema-leaderboard/schema/cell.schema.json"
      }
    },
    "source": {
      "const": "submission"
    }
  }
}
